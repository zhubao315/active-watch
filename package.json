{
  "name": "active-watch",
  "version": "2.0.0",
  "private": true,
  "description": "ACTIVE 四站运营中枢：巡检 / 数据水位 / 共享配额账本 / 品牌单一事实源",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs && python3 -m unittest discover -s tests -p 'test_quota_lease.py' -v",
    "test:brand": "node --test tests/brand-contract.test.mjs",
    "test:watermark": "node --test tests/data-watermark.test.mjs",
    "test:quota": "python3 -m unittest discover -s tests -p 'test_quota_lease.py' -v",
    "patrol": "node scripts/patrol.mjs",
    "verify:live": "node brand/verify-live.mjs",
    "verify:sites": "node brand/verify-sites.mjs",
    "watermark": "node tools/write-data-watermark.mjs",
    "assets:build": "node brand/build-assets.mjs"
  },
  "devDependencies": {
    "playwright": "^1.65.1"
  }
}
